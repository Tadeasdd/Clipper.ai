# Capstone D2 — local quality gate (mirrors CI before code leaves the machine).
#
# 1. lint-staged: Prettier-format + secret-scan ONLY the staged files. Because
#    nothing un-staged is touched, existing files (including the pixel-locked
#    landing visuals) are never reformatted wholesale.
# 2. Lint + typecheck the package that actually changed, reusing the same scripts
#    CI runs, so a commit can't pass locally yet fail the pipeline.
#
# Requires the root dev tooling: run `npm install` once at the repo root.

if ! npx --no-install lint-staged; then
  echo "pre-commit: lint-staged failed (or root dev deps missing — run \`npm install\`)." >&2
  exit 1
fi

staged() { git diff --cached --name-only --diff-filter=ACMR; }

if staged | grep -Eq '^frontend/src/.*\.(js|jsx)$'; then
  ( cd frontend && npm run lint && npm run typecheck ) || exit 1
fi

fail=0
for f in $(staged | grep -E '^backend/.*\.(js|mjs)$'); do
  node --check "$f" || fail=1
done
[ "$fail" -eq 0 ] || { echo "pre-commit: backend syntax check failed." >&2; exit 1; }
