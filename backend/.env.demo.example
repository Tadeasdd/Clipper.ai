# .env.demo.example — copy to .env.demo and fill in the four real keys.
#
# The demo deliberately needs FAR less than production: no Clerk, no Stripe.
# Just storage (R2) + the two AI providers. That's the whole point — minimal
# setup so you can get it in front of people fast.

# --- App ---
APP_ENV=production
LOG_LEVEL=INFO

# --- Demo mode (set by docker-compose.demo.yml, here for clarity) ---
DEMO_MODE=true

# --- Database (set by compose for local; override for a hosted demo) ---
DATABASE_URL=postgresql+asyncpg://clipper:clipper@postgres:5432/clipper

# --- Cloudflare R2 (REQUIRED) ---
# Cloudflare dashboard → R2 → Manage API tokens. Create a bucket first.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=clipper-demo
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com

# --- Deepgram (REQUIRED) — deepgram.com, $200 free credit ≈ 46,000 minutes ---
DEEPGRAM_API_KEY=

# --- Anthropic (REQUIRED) — segmentation + scoring ---
ANTHROPIC_API_KEY=

# --- Admin token (OPTIONAL) — set to read feedback via GET /v1/feedback ---
# Pick any long random string. Then:
#   curl -H "X-Admin-Token: <this>" https://<your-demo>/v1/feedback
ADMIN_TOKEN=

# --- NOT NEEDED FOR THE DEMO (left blank on purpose) ---
# CLERK_*        — demo mode bypasses auth
# STRIPE_*       — demo mode bypasses billing
# SENTRY_DSN     — optional; set if you want error tracking on the demo
