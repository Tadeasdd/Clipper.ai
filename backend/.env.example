# --- App ---
APP_ENV=development
LOG_LEVEL=INFO

# --- Database ---
# Local: postgresql+asyncpg://clipper:clipper@localhost:5432/clipper
# Supabase: postgresql+asyncpg://postgres.<ref>:<pw>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql+asyncpg://clipper:clipper@localhost:5432/clipper

# --- Cloudflare R2 ---
# Get these from Cloudflare dashboard → R2 → Manage API tokens
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=clipper-uploads
# Public dev URL or your custom domain. Used in presigned URLs.
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com

# --- Inngest ---
# Dev: leave EVENT_KEY and SIGNING_KEY blank to use dev server defaults
INNGEST_APP_ID=clipper-backend
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# --- CORS (Phase 1 — allow the Next.js frontend) ---
CORS_ORIGINS=http://localhost:3000,https://clipper.ai

# --- Phase 2: Transcription + LLM ---
# Deepgram — sign up at deepgram.com, $200 free credit covers ~46,000 minutes
DEEPGRAM_API_KEY=

# Anthropic — for segmentation (P2) and virality scoring (P3)
ANTHROPIC_API_KEY=

# FFmpeg binary path. Override only if not on $PATH (e.g. macOS Homebrew = /opt/homebrew/bin/ffmpeg).
FFMPEG_BIN=ffmpeg

# --- Phase 5: Auth + Billing ---
# Clerk — sign up at clerk.com, create an application, copy the values from API Keys.
# JWKS URL: https://{your-frontend-api}.clerk.accounts.dev/.well-known/jwks.json
CLERK_JWKS_URL=
CLERK_ISSUER=
CLERK_WEBHOOK_SECRET=

# Stripe — sign up at stripe.com, get sk_live_/sk_test_ key. Webhook secret is per-endpoint.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Price IDs for the three plan tiers (create products in Stripe dashboard, copy IDs here).
STRIPE_PRICE_STARTER=
STRIPE_PRICE_STUDIO=
STRIPE_PRICE_SCALE=

# Where Stripe Checkout redirects after success/cancel. Set per environment.
STRIPE_CHECKOUT_SUCCESS_URL=http://localhost:3000/billing/success
STRIPE_CHECKOUT_CANCEL_URL=http://localhost:3000/pricing

# ────────────────────────────────────────────────────────── Phase 6 hardening
# Sentry — leave empty to disable. SaaS DSN format: https://abc@o123.ingest.sentry.io/456
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1

# Rate limiting — token-bucket per (org, endpoint-group). Disable for load testing.
RATE_LIMIT_ENABLED=true
