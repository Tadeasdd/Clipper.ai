# ── Stage B1: core ─────────────────────────────────────────────
PORT=8080
DATABASE_URL=postgres://clipper:clipper@localhost:5432/clipper

# ── Stage B2: ingest ───────────────────────────────────────────
# STORAGE_DRIVER=local (default): files under backend/storage/, uploads PUT
#   through the API. STORAGE_DRIVER=s3: presigned PUT direct to the bucket.
STORAGE_DRIVER=local
STORAGE_DIR=
# S3-compatible object storage (used when STORAGE_DRIVER=s3)
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ── Stage B3: transcription / analysis ─────────────────────────
TRANSCRIPTION_PROVIDER=        # e.g. whisper | deepgram | assemblyai
TRANSCRIPTION_API_KEY=
LLM_PROVIDER=                  # moment detection + scoring models
LLM_API_KEY=

# ── Stage B5: publishing ───────────────────────────────────────
# Per-platform tokens are stored per-client in the DB; these are app creds
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
META_APP_ID=
META_APP_SECRET=

# ── Stage B6: analytics ────────────────────────────────────────
POSTHOG_API_KEY=
POSTHOG_HOST=https://eu.i.posthog.com
