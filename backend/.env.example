# ── Stage B1: core ─────────────────────────────────────────────
PORT=8080
DATABASE_URL=postgres://clipper:clipper@localhost:5432/clipper
# M7 production hardening (only enforced when NODE_ENV=production):
#   PUBLISH_TOKEN_KEY + DATABASE_URL must be set or the API refuses to boot.
NODE_ENV=development
PUBLISH_TOKEN_KEY=             # strong random secret; encrypts stored creds
CORS_ORIGINS=                  # comma list of allowed browser origins; blank = open (dev only)
# S5: with cookie sessions the API sends Access-Control-Allow-Credentials and
# reflects the specific origin (never *). HSTS is sent when NODE_ENV=production.
# The Content-Security-Policy ships in the frontend build (a meta tag injected by
# vite.config.js) — it governs the app document, not these API responses.
SENTRY_DSN=                    # optional error reporting; blank = off (redacted, best-effort)
# S6: logs are one-line JSON to stdout/stderr — info/audit to stdout, errors to
# stderr — with secrets (tokens, passwords, cookies, credentials) redacted. The
# security audit trail (logins, bootstrap, logout, rate-limit trips, authz
# denials, retrains) rides the same channel as msg:"security". Every response
# carries an X-Request-Id; a 500 returns it so the client error ties to the log.
# Per-IP rate limits per minute for the public doors (0 disables):
RATELIMIT_LEADS_PER_MIN=60
RATELIMIT_INTAKE_PER_MIN=120

# ── Stage B2: ingest ───────────────────────────────────────────
# STORAGE_DRIVER=local (default): files under backend/storage/, uploads PUT
#   through the API. STORAGE_DRIVER=s3: presigned PUT direct to the bucket.
STORAGE_DRIVER=local
STORAGE_DIR=
# Cap on stored media bytes — bounds both client uploads (PUT) and URL/yt-dlp
# pulls (they share saveStream / --max-filesize). 0 or unset = unlimited.
MAX_UPLOAD_BYTES=
# yt-dlp CLI for platform URLs (YouTube etc.); a plain fetch only gets HTML.
YTDLP_BIN=yt-dlp
# ── S1: SSRF guard on the server-side fetch of a client-supplied source_url ──
# Defaults are locked down: https only, and any host that resolves to a private,
# loopback, link-local (incl. 169.254 cloud metadata), or reserved IP is refused
# — redirects are re-checked and the resolved IP is pinned (no DNS rebinding).
INGEST_ALLOW_HTTP=            # true permits http:// sources (default: https only)
INGEST_HOST_ALLOWLIST=       # comma hosts; when set, fetches are restricted to
                             #   exactly these (and they skip the private-IP check)
INGEST_FETCH_TIMEOUT_MS=20000
INGEST_MAX_REDIRECTS=5
# S3-compatible object storage (used when STORAGE_DRIVER=s3)
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ── Stage B3: pipeline ─────────────────────────────────────────
WORKERS_ENABLED=true           # false → run workers separately: npm run worker
PIPELINE_CONCURRENCY=1         # worker loops per process (SKIP LOCKED-safe)
PIPELINE_POLL_MS=1000
# M5 queue reliability: a job stuck 'running'/'publishing' longer than the
# visibility timeout (a crashed worker) is reclaimed by the reaper sweep.
JOB_VISIBILITY_TIMEOUT_S=300   # how long before a running job is presumed dead
JOB_REAP_INTERVAL_MS=5000      # how often the reaper sweeps (kept short)
GENERATE_TOP_N=4               # candidates rendered per recording

# Providers. builtin = offline dev provider (no ASR words; template hooks).
# whisper = offline real word timestamps via whisper.cpp (no paid key); set
#   WHISPER_MODEL to a ggml model file and install the CLI (WHISPER_BIN).
# deepgram = cloud scale path; needs TRANSCRIPTION_API_KEY.
TRANSCRIPTION_PROVIDER=builtin # builtin | whisper | deepgram
TRANSCRIPTION_API_KEY=
WHISPER_BIN=whisper-cli        # whisper.cpp CLI on PATH (or absolute path)
WHISPER_MODEL=                 # e.g. /opt/whisper/models/ggml-tiny.en.bin
WHISPER_LANG=                  # blank = auto-detect; e.g. en to force English
LLM_PROVIDER=builtin           # builtin | anthropic (hooks need a transcript)
LLM_API_KEY=
LLM_MODEL=claude-haiku-4-5-20251001

# ── Stage B5: publishing ───────────────────────────────────────
# Drivers default to local (storage outbox) so CI/offline dev need zero creds.
# Flip to live to publish/measure against real platforms — see
# docs/RUNBOOK_YOUTUBE.md. (M6: YouTube is the one verified live path.)
PUBLISH_DRIVER=local           # local | live
METRICS_DRIVER=local           # local | live
# Per-platform tokens are stored per-client in the DB (minted via the OAuth
# connect flow); these are the app-level OAuth client creds.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
# Public base URL the YouTube OAuth callback redirects to; must match the
# redirect URI registered in the Google Cloud console exactly.
OAUTH_REDIRECT_BASE=http://localhost:8080
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
META_APP_ID=
META_APP_SECRET=

# ── Stage B6: analytics ────────────────────────────────────────
POSTHOG_API_KEY=
POSTHOG_HOST=https://eu.i.posthog.com
# ── Q5: online quality calibration + drift alerting ────────────
# The monitor snapshots how well clips.score predicts realized performance and
# alerts when it decays. Under METRICS_DRIVER=local performance is score-
# independent, so calibration sits near null and never false-alarms.
DRIFT_WINDOW_DAYS=14
DRIFT_THRESHOLD=0.4              # calibration drop vs the prior snapshot that counts as drift
DRIFT_SNAPSHOT_INTERVAL_S=21600 # how often the monitor takes a snapshot (6h)
ALERT_WEBHOOK_URL=              # drift alerts POST here; blank = dry-run (logged only). Track R adds routing.
# ── R1: observability — traces + Prometheus metrics ────────────
METRICS_TOKEN=                  # bearer required to scrape GET /metrics; blank = open (dev/CI)
OTEL_EXPORTER_OTLP_ENDPOINT=    # OTLP/HTTP collector for traces; blank = kept in-memory only (no export)
# ── R2: graceful shutdown — drain in-flight jobs on SIGTERM ────
SHUTDOWN_TIMEOUT_MS=25000        # overall budget to drain before forcing exit
JOB_DRAIN_TIMEOUT_MS=20000       # per-queue wait for in-flight pipeline/publish jobs to finish
# ── R3: resilience on external calls (timeout / breaker / bulkhead) ──
# Per-dependency timeouts (only the live provider paths make outbound calls):
LLM_TIMEOUT_MS=30000
ASR_TIMEOUT_MS=120000
PUBLISH_TIMEOUT_MS=120000
METRICS_TIMEOUT_MS=15000
CIRCUIT_THRESHOLD=5              # consecutive failures before a breaker opens
CIRCUIT_COOLDOWN_MS=15000        # how long an open breaker fails fast before a half-open trial
BULKHEAD_MAX=8                   # max concurrent calls per dependency before shedding
# ── R4: SLOs + error budgets ───────────────────────────────────
SLO_SUCCESS_TARGET=0.99          # processing success-rate objective
SLO_TURNAROUND_P95_S=1800        # p95 intake→ready turnaround objective (seconds)
SLO_WINDOW_S=86400               # rolling window the SLIs are measured over
SLO_BURN_ALERT=true              # fire an alert when an error budget is burning (uses ALERT_WEBHOOK_URL)
# ── R5: disaster recovery (backups + chaos) ────────────────────
BACKUP_DIR=./backups             # where ops/backup/backup.sh writes pg_dumps
BACKUP_KEEP=7                    # how many dumps to retain (oldest pruned)
CHAOS_RTO_S=20                   # pipeline recovery-time budget the chaos drill asserts
# ── E1: per-job cost ledger (USD per unit; realistic cloud defaults) ──
COST_ASR_PER_SEC=0.0001          # managed ASR, per audio-second (builtin = $0)
COST_LLM_IN_PER_TOK=0.0000008    # LLM input tokens (builtin = $0)
COST_LLM_OUT_PER_TOK=0.000004    # LLM output tokens
COST_CPU_PER_MS=0.0000000167     # render compute, per cpu-ms
COST_STORAGE_PER_BYTE=0.0000000000211  # object storage, per byte-month
COST_EGRESS_PER_BYTE=0.00000000009     # egress, per byte
# ── E2: usage metering + plan quotas ───────────────────────────
USAGE_SOFT_PCT=0.8               # fraction of quota that flips a client to the 'warn' state
# ── E3: margin dashboard (human-editor cost estimate) ──────────
EDITOR_HOURLY_USD=35             # blended editor rate for the margin estimate
EDITOR_MIN_PER_REVIEW=4          # estimated minutes per review decision
