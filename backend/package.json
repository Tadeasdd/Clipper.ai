{
  "name": "clipper-backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "smoke": "node scripts/smoke.mjs",
    "migrate": "node -e \"import('./src/db/index.js').then(m=>m.migrate()).then(()=>process.exit(0))\"",
    "worker": "node -e \"import('./src/pipeline/index.js').then(m=>m.startWorkers())\"",
    "smoke:transcribe": "node scripts/smoke-transcribe.mjs",
    "smoke:ssrf": "node scripts/smoke-ssrf.mjs",
    "smoke:ingest": "node scripts/smoke-ingest.mjs",
    "smoke:pipeline": "node scripts/smoke-pipeline.mjs",
    "smoke:review": "node scripts/smoke-review.mjs",
    "smoke:publish": "node scripts/smoke-publish.mjs",
    "smoke:metrics": "node scripts/smoke-metrics.mjs",
    "smoke:labels": "node scripts/smoke-labels.mjs",
    "smoke:auth": "node scripts/smoke-auth.mjs",
    "smoke:authz": "node scripts/smoke-authz.mjs",
    "smoke:provenance": "node scripts/smoke-provenance.mjs",
    "smoke:cache": "node scripts/smoke-cache.mjs",
    "smoke:drift": "node scripts/smoke-drift.mjs",
    "smoke:observability": "node scripts/smoke-observability.mjs",
    "smoke:shutdown": "node scripts/smoke-shutdown.mjs",
    "smoke:resilience": "node scripts/smoke-resilience.mjs",
    "smoke:slo": "node scripts/smoke-slo.mjs",
    "smoke:restore": "node scripts/smoke-restore.mjs",
    "smoke:chaos": "node scripts/smoke-chaos.mjs",
    "smoke:cost": "node scripts/smoke-cost.mjs",
    "smoke:metering": "node scripts/smoke-metering.mjs",
    "smoke:margin": "node scripts/smoke-margin.mjs",
    "smoke:prod": "node scripts/smoke-prod.mjs",
    "seed:demo": "node scripts/seed-demo.mjs",
    "eval": "node scripts/eval.mjs",
    "audit:ci": "npm audit --omit=dev --audit-level=high"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1066.0",
    "@aws-sdk/s3-request-presigner": "^3.1066.0",
    "cors": "^2.8.5",
    "express": "^4.21.0",
    "pg": "^8.21.0"
  }
}
